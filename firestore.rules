rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile & Custom Claims Lookup
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return request.auth.token.role != null 
        ? request.auth.token.role 
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? getUserData().role : 'student');
    }

    function getSchoolId() {
      return request.auth.token.schoolId != null 
        ? request.auth.token.schoolId 
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 'schoolId' in getUserData() ? getUserData().schoolId : 'bitc');
    }

    // Multi-tenant Access Guards
    function isSuperAdmin() {
      return isAuthenticated() && (
        getRole() == 'super_admin' || 
        request.auth.token.email in ["davmuchiri48@gmail.com", "daudimuchiri4@gmail.com"]
      );
    }

    function isSchoolAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() || 
        getRole() == 'school_admin' || 
        getRole() == 'admin'
      );
    }

    function isPrincipal() {
      return isAuthenticated() && (
        isSchoolAdmin() || 
        getRole() == 'principal'
      );
    }

    function isAccountant() {
      return isAuthenticated() && (
        isSchoolAdmin() || 
        getRole() == 'accountant' || 
        getRole() == 'staff'
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        isSchoolAdmin() || 
        isPrincipal() || 
        getRole() == 'teacher'
      );
    }

    function isStudent() {
      return isAuthenticated() && getRole() == 'student';
    }

    function isParent() {
      return isAuthenticated() && getRole() == 'parent';
    }

    function isSameSchool(dataSchoolId) {
      return isSuperAdmin() || (dataSchoolId == getSchoolId());
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function schoolIdUnchanged() {
      return !('schoolId' in existing()) || !('schoolId' in incoming()) || incoming().schoolId == existing().schoolId;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.email is string &&
             (!('schoolId' in data) || (data.schoolId is string && data.schoolId.size() <= 64)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 40)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 500)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2000)) &&
             (!('classIds' in data) || (data.classIds is list)) &&
             (!('createdAt' in data) || (data.createdAt is string));
    }

    function isValidSettings(data, settingId) {
      return (settingId == 'hero_legacy' ? data.images is list :
             (settingId == 'gallery' ? data.images is list :
             (data.appTitle is string && data.appTitle.size() <= 100)));
    }

    // --- Multi-Tenant Collection Rules ---

    // Schools Collection
    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (isSchoolAdmin() && schoolId == getSchoolId());

      // Nested Sub-collection Support for Tenant-scoped queries
      match /{subcollection}/{docId} {
        allow read, write: if isSuperAdmin() || schoolId == getSchoolId();
      }
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.schoolId == getSchoolId() || isOwner(userId));
      allow create: if isAuthenticated() && (
        isOwner(userId) || 
        isSchoolAdmin() || 
        isTeacher()
      ) && isValidUser(incoming());
      allow update: if isAuthenticated() && (
        isSchoolAdmin() || 
        isTeacher() ||
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'phoneNumber', 'phone', 'fcmTokens', 'course', 'photoUrl', 
          'residence', 'bloodGroup', 'admissionNumber', 'year', 'updatedAt',
          'specialization', 'schoolId'
        ]))
      ) && isValidUser(incoming()) && schoolIdUnchanged();
      allow delete: if isSchoolAdmin();
    }

    // Separate Student Records
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        isSameSchool(resource.data.schoolId) || 
        resource.data.userId == request.auth.uid ||
        resource.data.guardianId == request.auth.uid
      );
      allow write: if (isSchoolAdmin() || isPrincipal() || isTeacher()) && schoolIdUnchanged();
    }

    // Parent Records
    match /parents/{parentId} {
      allow read: if isAuthenticated() && (
        isSameSchool(resource.data.schoolId) || 
        request.auth.uid == parentId ||
        (request.auth.uid in resource.data.studentIds)
      );
      allow write: if isSchoolAdmin() && schoolIdUnchanged();
    }

    // Departments, Courses, Classes, Units, Semesters, Academic Years
    match /departments/{deptId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    match /classes/{classId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    match /units/{unitId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    match /semesters/{semesterId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    match /academicYears/{yearId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Exams & Submissions
    match /exams/{examId} {
      allow read: if isAuthenticated() && (isSameSchool(resource.data.schoolId) || !('schoolId' in resource.data));
      allow write: if (isSchoolAdmin() || isTeacher()) && isValidId(examId) && schoolIdUnchanged();
    }

    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (isTeacher() || isOwner(resource.data.studentId) || isSameSchool(resource.data.schoolId));
      allow create: if isAuthenticated() && isOwner(incoming().studentId) && isValidId(submissionId);
      allow update: if (isSchoolAdmin() || isTeacher()) && schoolIdUnchanged();
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidId(attendanceId) && schoolIdUnchanged();
    }

    match /exam_attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if (isSchoolAdmin() || isTeacher()) && isValidId(attendanceId) && schoolIdUnchanged();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.senderId == request.auth.uid || 
        (resource.data.userId == 'SYSTEM_ANNOUNCEMENT_ARCHIVE' && isSchoolAdmin())
      );
      allow create: if isSchoolAdmin() || isTeacher();
      allow update: if isOwner(resource.data.userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(resource.data.userId) || isSchoolAdmin();
    }

    // Fees, Payments & Expenses
    match /fees/{feeId} {
      allow list: if isAuthenticated() && (isAccountant() || resource.data.studentId == request.auth.uid);
      allow get: if isAuthenticated() && (isAccountant() || resource.data.studentId == request.auth.uid);
      allow create: if isAccountant();
      allow update: if isAccountant() && schoolIdUnchanged();
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (isAccountant() || resource.data.studentId == request.auth.uid);
      allow write: if isAccountant() && schoolIdUnchanged();
    }

    match /feeConfigs/{feeId} {
      allow read: if isAuthenticated();
      allow write: if isAccountant() && schoolIdUnchanged();
    }

    match /feeTypes/{typeId} {
      allow read: if isAuthenticated();
      allow write: if isAccountant() && schoolIdUnchanged();
    }

    match /feeGroups/{groupId} {
      allow read: if isAuthenticated();
      allow write: if isAccountant() && schoolIdUnchanged();
    }

    match /expenses/{expenseId} {
      allow read: if isAccountant();
      allow write: if isAccountant() && schoolIdUnchanged();
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (isAccountant() || resource.data.studentId == request.auth.uid);
      allow write: if isAccountant() && schoolIdUnchanged();
    }

    match /budgets/{budgetId} {
      allow read: if isAccountant();
      allow write: if isAccountant() && schoolIdUnchanged();
    }

    match /creditDebitNotes/{noteId} {
      allow read: if isAuthenticated() && (isAccountant() || resource.data.studentId == request.auth.uid);
      allow write: if isAccountant() && schoolIdUnchanged();
    }

    match /scholarships/{scholarshipId} {
      allow read: if isAuthenticated() && (isAccountant() || resource.data.studentId == request.auth.uid);
      allow write: if isAccountant() && schoolIdUnchanged();
    }

    match /installmentPlans/{planId} {
      allow read: if isAuthenticated() && (isAccountant() || resource.data.studentId == request.auth.uid);
      allow write: if isAccountant() && schoolIdUnchanged();
    }

    match /studentAccounts/{accountId} {
      allow read: if isAuthenticated() && (isAccountant() || resource.data.studentId == request.auth.uid);
      allow write: if isAccountant() && schoolIdUnchanged();
    }

    // Audit Logs - Immutable log table
    match /auditLogs/{logId} {
      allow read: if isSchoolAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Audit logs must be append-only
    }

    // System Settings & Calendar
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSchoolAdmin() && isValidSettings(incoming(), settingId);
    }

    match /school_calendar/{dateId} {
      allow read: if isAuthenticated();
      allow write: if isSchoolAdmin();
    }
    
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /grades/{gradeId} {
      allow read: if isAuthenticated();
      allow write: if isSchoolAdmin();
    }

    match /admissions/{admissionId} {
      allow read: if isSchoolAdmin() || isTeacher();
      allow create: if true; // Public Online Admission
      allow update, delete: if isSchoolAdmin() || isTeacher();
    }

    // Chat Rules
    match /chat_rooms/{roomId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants);
    }

    match /chat_messages/{messageId} {
      allow read: if isAuthenticated() && exists(/databases/$(database)/documents/chat_rooms/$(resource.data.roomId)) && 
                     (request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(resource.data.roomId)).data.participants);
      allow create: if isAuthenticated() && exists(/databases/$(database)/documents/chat_rooms/$(request.resource.data.roomId)) && 
                      (request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(request.resource.data.roomId)).data.participants);
    }
  }
}
